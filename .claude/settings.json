{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git stash list)",
      "Bash(git branch --show-current)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm docs:build)",
      "Bash(pnpm exec vitest run)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm --filter * build)",
      "Bash(pnpm --filter * test)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(pnpm --filter * lint)",
      "Bash(pnpm --filter @mapomodule/mcp knowledge)",
      "mcp__mapo__mapo_search_docs",
      "mcp__mapo__mapo_get_doc",
      "mcp__mapo__mapo_list_recipes",
      "mcp__mapo__mapo_component_api",
      "mcp__mapo__mapo_list_field_types",
      "mcp__mapo__mapo_composable_api",
      "mcp__mapo__mapo_inspect_app",
      "mcp__mapo__mapo_doctor",
      "mcp__mapo__mapo_backend_schema",
      "mcp__nuxt-ui",
      "WebFetch(domain:nuxt.com)",
      "WebFetch(domain:ui.nuxt.com)",
      "WebFetch(domain:vuejs.org)",
      "WebFetch(domain:pinia.vuejs.org)",
      "WebFetch(domain:i18n.nuxtjs.org)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:vitepress.dev)",
      "WebFetch(domain:mcp-toolkit.nuxt.dev)",
      "WebFetch(domain:modelcontextprotocol.io)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git stash drop)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add --all)",
      "Bash(git add --all *)",
      "Bash(git add .)",
      "Bash(pnpm release)",
      "Bash(pnpm release *)",
      "Bash(pnpm release:dry)",
      "Bash(pnpm release:dry *)",
      "Bash(pnpm publish:packages)",
      "Bash(pnpm publish:packages *)",
      "Bash(pnpm publish *)",
      "Bash(pnpm -r publish *)",
      "Bash(pnpm -r * publish *)",
      "Bash(npm publish)",
      "Bash(npm publish *)",
      "Bash(npx multi-semantic-release *)",
      "Bash(pnpm exec multi-semantic-release *)",
      "Bash(gh workflow run *)",
      "Bash(gh pr create *)",
      "Bash(gh release *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./testing/**)",
      "Write(./testing/**)",
      "Edit(./docs/DECISIONS.md)",
      "Write(./docs/DECISIONS.md)",
      "Edit(./docs/roadmap/**)",
      "Write(./docs/roadmap/**)"
    ]
  }
}
