{
  "name": "@mapomodule/uikit",
  "version": "2.0.0-beta.1",
  "description": "Mapo UI components: Sidebar, Topbar, Login, SnackBar, ConfirmDialog, List, Detail, Media",
  "type": "module",
  "license": "MIT",
  "author": "Lotrek Agency (https://lotrek.it)",
  "homepage": "https://lotrekagency.github.io/mapo-new/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lotrekagency/mapo-new.git",
    "directory": "packages/@mapomodule/uikit"
  },
  "bugs": {
    "url": "https://github.com/lotrekagency/mapo-new/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./types": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./runtime/*": {
      "types": "./src/runtime/*.ts",
      "import": "./dist/runtime/*.js",
      "default": "./src/runtime/*"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "nuxt-module-build build && vue-tsc -p tsconfig.build-types.json && node ../../../scripts/clean-empty-vue-dts.mjs dist",
    "dev": "nuxt-module-build build --stub --watch",
    "prepack": "pnpm build",
    "dev:prepare": "nuxt-module-build build --stub",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@mapomodule/form": "workspace:*",
    "@mapomodule/store": "workspace:*",
    "@mapomodule/utils": "workspace:*",
    "@mapomodule/core": "workspace:*",
    "tailwindcss": "^4.0.0"
  },
  "peerDependencies": {
    "@nuxt/ui": ">=4.0.0",
    "nuxt": ">=4.0.0"
  },
  "devDependencies": {
    "@nuxt/kit": "4.4.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "4.4.2",
    "@nuxt/ui": "^4.7.0",
    "@tanstack/vue-table": "^8.21.3",
    "nuxt": "^4.4.2",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "vue-tsc": "^3.3.4"
  }
}
