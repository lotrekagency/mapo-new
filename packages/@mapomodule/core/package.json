{
  "name": "@mapomodule/core",
  "version": "1.0.0",
  "description": "Mapo core: API layer, auth, composables, middleware",
  "type": "module",
  "license": "MIT",
  "author": "Lotrek Agency (https://lotrek.it)",
  "homepage": "https://lotrekagency.github.io/mapo-new/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lotrekagency/mapo-new.git",
    "directory": "packages/@mapomodule/core"
  },
  "bugs": {
    "url": "https://github.com/lotrekagency/mapo-new/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./types": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./runtime/*": {
      "types": "./src/runtime/*.ts",
      "import": "./dist/runtime/*.js",
      "default": "./src/runtime/*"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "nuxt-module-build build --stub --watch",
    "build": "nuxt-module-build build && tsc -p tsconfig.build-types.json",
    "prepare": "nuxt-module-build build --stub",
    "dev:prepare": "nuxt-module-build build --stub",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@mapomodule/store": "workspace:*",
    "@mapomodule/utils": "workspace:*"
  },
  "peerDependencies": {
    "nuxt": ">=4.0.0"
  },
  "devDependencies": {
    "@nuxt/kit": "4.4.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "4.4.2",
    "nuxt": "^4.5.1",
    "ofetch": "^1.5.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  }
}
