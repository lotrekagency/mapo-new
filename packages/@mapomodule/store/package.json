{
  "name": "@mapomodule/store",
  "version": "2.0.0-beta.1",
  "description": "Mapo Pinia stores",
  "type": "module",
  "license": "MIT",
  "author": "Lotrek Agency (https://lotrek.it)",
  "homepage": "https://lotrekagency.github.io/mapo-new/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lotrekagency/mapo-new.git",
    "directory": "packages/@mapomodule/store"
  },
  "bugs": {
    "url": "https://github.com/lotrekagency/mapo-new/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./types": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./runtime/*": {
      "types": "./src/runtime/*.ts",
      "import": "./dist/runtime/*.js",
      "default": "./src/runtime/*"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "nuxt-module-build build --stub --watch",
    "build": "nuxt-module-build build && tsc -p tsconfig.build-types.json",
    "prepack": "pnpm build",
    "dev:prepare": "nuxt-module-build build --stub",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3"
  },
  "peerDependencies": {
    "nuxt": ">=4.0.0",
    "pinia": "^3.0.0"
  },
  "devDependencies": {
    "@nuxt/kit": "4.4.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "4.4.2",
    "nuxt": "^4.4.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.32"
  }
}
