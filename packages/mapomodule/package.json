{
  "name": "mapomodule",
  "version": "2.0.0-beta.2",
  "description": "Mapo meta-package: registers and re-exports all @mapomodule/* modules",
  "type": "module",
  "license": "MIT",
  "author": "Lotrek Agency (https://lotrek.it)",
  "homepage": "https://lotrekagency.github.io/mapo-new/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lotrekagency/mapo-new.git",
    "directory": "packages/mapomodule"
  },
  "bugs": {
    "url": "https://github.com/lotrekagency/mapo-new/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./types": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nuxt-module-build build --stub --watch",
    "build": "nuxt-module-build build",
    "prepack": "pnpm build",
    "dev:prepare": "nuxt-module-build build --stub",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "nuxt": ">=4.0.0"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@mapomodule/core": "workspace:*",
    "@mapomodule/form": "workspace:*",
    "@mapomodule/i18n": "workspace:*",
    "@mapomodule/store": "workspace:*",
    "@mapomodule/uikit": "workspace:*",
    "@mapomodule/utils": "workspace:*",
    "@nuxt/ui": "^4.7.0"
  },
  "devDependencies": {
    "@nuxt/kit": "4.4.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "4.4.2",
    "nuxt": "^4.5.1",
    "vue": "^3.5.40"
  }
}
