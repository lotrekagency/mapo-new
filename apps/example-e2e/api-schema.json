{
  "openapi": "3.0.3",
  "info": {
    "title": "example-e2e mock API",
    "version": "1.0.0",
    "description": "Hand-maintained OpenAPI description of the in-memory API served by server/api/**, in the shape drf-spectacular would emit. It is a curated subset of the Article stress-test model — enough to exercise every mapping rule of mapo_backend_schema without duplicating 150 properties. Relations are declared as nested components because that is how the app's own form treats them (fks/m2m with returnObject: false), while the wire format carries plain ids."
  },
  "paths": {
    "/api/articles": {
      "get": {
        "operationId": "articles_list",
        "responses": {
          "200": {
            "description": "Paginated list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer" },
                    "results": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Article" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "articles_create",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Article" }
              }
            }
          }
        }
      }
    },
    "/api/articles/{id}": {
      "get": {
        "operationId": "articles_retrieve",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "One article",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Article" }
              }
            }
          }
        }
      }
    },
    "/api/pages": {
      "get": {
        "operationId": "pages_list",
        "responses": {
          "200": {
            "description": "Paginated list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Page"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "pages_create",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          }
        }
      }
    },
    "/api/pages/{id}": {
      "get": {
        "operationId": "pages_retrieve",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          }
        }
      }
    },
    "/api/authors": {
      "get": {
        "operationId": "authors_list",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          {
            "name": "page_size",
            "in": "query",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list, 20 a page, searched by name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer" },
                    "next": { "type": "string", "nullable": true },
                    "previous": { "type": "string", "nullable": true },
                    "results": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Author" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/reviewers": {
      "get": {
        "operationId": "reviewers_list",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Bare array, searched by email and name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Reviewer" }
                }
              }
            }
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "operationId": "categories_list",
        "responses": {
          "200": {
            "description": "Bare array, as the mock serves it",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Category" }
                }
              }
            }
          }
        }
      }
    },
    "/api/tags": {
      "get": {
        "operationId": "tags_list",
        "responses": {
          "200": {
            "description": "Bare array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Tag" }
                }
              }
            }
          }
        }
      }
    },
    "/api/topics": {
      "get": {
        "operationId": "topics_list",
        "responses": {
          "200": {
            "description": "Bare array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Topic" }
                }
              }
            }
          }
        }
      }
    },
    "/api/series": {
      "get": {
        "operationId": "series_list",
        "responses": {
          "200": {
            "description": "Bare array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Series" }
                }
              }
            }
          }
        }
      }
    },
    "/api/profiles": {
      "get": {
        "operationId": "profiles_list",
        "responses": {
          "200": {
            "description": "Bare array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Profile" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Article": {
        "type": "object",
        "description": "Curated subset of the article model exercised by /form/article/[id].",
        "required": ["title", "slug", "status"],
        "properties": {
          "id": { "type": "integer", "readOnly": true },
          "title": { "type": "string", "maxLength": 200, "title": "Title" },
          "slug": { "type": "string", "maxLength": 200 },
          "excerpt": {
            "type": "string",
            "maxLength": 500,
            "description": "Short teaser shown in listings."
          },
          "body": {
            "type": "string",
            "description": "Main content, rich text."
          },
          "status": {
            "type": "string",
            "title": "Publication status",
            "enum": ["draft", "review", "ready", "published", "archived"]
          },
          "visibility": {
            "type": "string",
            "enum": ["public", "private", "unlisted"]
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "embargo_until": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "featured": { "type": "boolean" },
          "allow_comments": { "type": "boolean" },
          "reading_time": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120,
            "description": "Minutes."
          },
          "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
          "canonical_url": { "type": "string", "format": "uri" },
          "cover_image": {
            "type": "string",
            "format": "binary",
            "nullable": true
          },
          "category": {
            "allOf": [{ "$ref": "#/components/schemas/Category" }],
            "nullable": true
          },
          "series": {
            "allOf": [{ "$ref": "#/components/schemas/Series" }],
            "nullable": true
          },
          "tags": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Tag" }
          },
          "topics": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Topic" }
          },
          "gallery": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GalleryItem" },
            "description": "Inline images; no collection endpoint serves them."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },
      "Page": {
        "type": "object",
        "description": "A landing page made of blocks, filled by the AI lab's block page, /ai/ollama/blocks/[id].",
        "required": ["title"],
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "slug": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[-a-zA-Z0-9_]+$"
          },
          "summary": {
            "type": "string",
            "maxLength": 300
          },
          "intro": {
            "type": "string",
            "description": "Rich text."
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PageBlock"
            },
            "description": "A JSON field: the backend does not describe the blocks, the form's templates do."
          },
          "reviews": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/PageReview"
            }
          },
          "locations": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/PageLocation"
            }
          },
          "seo": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 60
              },
              "description": {
                "type": "string",
                "maxLength": 160
              },
              "permalink": {
                "type": "string",
                "maxLength": 200
              }
            }
          },
          "status": {
            "type": "string",
            "enum": ["draft", "review", "published"]
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "show_until": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "show_in_menu": {
            "type": "boolean"
          },
          "featured": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "accent_color": {
            "type": "string",
            "maxLength": 7
          },
          "contact_email": {
            "type": "string",
            "format": "email"
          },
          "website": {
            "type": "string",
            "format": "uri"
          },
          "country": {
            "type": "string",
            "enum": ["IT", "CH", "FR", "DE", "AT", "ES", "GB", "US"],
            "nullable": true
          },
          "audiences": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["families", "students", "tourists", "residents"]
            }
          },
          "category": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Category"
              }
            ],
            "nullable": true
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tag"
            }
          },
          "cover": {
            "type": "object",
            "nullable": true,
            "description": "A media of the media manager."
          },
          "gallery": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Media of the media manager."
          },
          "video": {
            "type": "object",
            "nullable": true,
            "description": "A media with its alt text and caption."
          },
          "brochure": {
            "type": "string",
            "format": "binary",
            "nullable": true
          },
          "position": {
            "type": "object",
            "nullable": true,
            "properties": {
              "lat": {
                "type": "number"
              },
              "lng": {
                "type": "number"
              }
            }
          },
          "webhook_secret": {
            "type": "string",
            "maxLength": 64,
            "writeOnly": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },
      "PageBlock": {
        "type": "object",
        "description": "One block of a page: `_template` names it (hero, text, quote, faq, stats, event, columns, gallery, credits, contact), the other properties are its fields.",
        "required": ["_template"],
        "properties": {
          "_template": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "PageReview": {
        "type": "object",
        "required": ["author"],
        "properties": {
          "author": {
            "type": "string",
            "maxLength": 80
          },
          "quote": {
            "type": "string",
            "maxLength": 300
          },
          "stars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "nullable": true
          },
          "date": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        }
      },
      "PageLocation": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "address": {
            "type": "string",
            "maxLength": 200
          },
          "country": {
            "type": "string",
            "enum": ["IT", "CH", "FR", "DE", "AT", "ES", "GB", "US"],
            "nullable": true
          },
          "phone": {
            "type": "string",
            "maxLength": 30
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "opening_hours": {
            "type": "array",
            "maxItems": 7,
            "items": {
              "$ref": "#/components/schemas/PageOpeningHours"
            }
          }
        }
      },
      "PageOpeningHours": {
        "type": "object",
        "required": ["day"],
        "properties": {
          "day": {
            "type": "string",
            "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
          },
          "opens": {
            "type": "string",
            "format": "time",
            "nullable": true
          },
          "closes": {
            "type": "string",
            "format": "time",
            "nullable": true
          },
          "closed": {
            "type": "boolean"
          }
        }
      },
      "Author": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "readOnly": true },
          "name": { "type": "string", "maxLength": 100 }
        }
      },
      "Reviewer": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "readOnly": true },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "name": { "type": "string", "maxLength": 100 }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "readOnly": true },
          "name": { "type": "string", "maxLength": 100 },
          "slug": { "type": "string", "maxLength": 100 }
        }
      },
      "Tag": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "readOnly": true },
          "name": { "type": "string", "maxLength": 60 },
          "color": { "type": "string", "maxLength": 7 }
        }
      },
      "Topic": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "readOnly": true },
          "name": { "type": "string", "maxLength": 60 },
          "slug": { "type": "string", "maxLength": 60 }
        }
      },
      "Series": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "readOnly": true },
          "name": { "type": "string", "maxLength": 120 },
          "slug": { "type": "string", "maxLength": 120 },
          "total_parts": { "type": "integer", "minimum": 1 }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "readOnly": true },
          "name": { "type": "string", "maxLength": 120 },
          "email": { "type": "string", "format": "email" },
          "role": {
            "type": "string",
            "enum": ["admin", "editor", "viewer"]
          }
        }
      },
      "GalleryItem": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "alt": { "type": "string", "maxLength": 200 },
          "caption": { "type": "string", "maxLength": 200 },
          "credit": { "type": "string", "maxLength": 120 },
          "type": { "type": "string", "enum": ["image", "video"] }
        }
      }
    }
  }
}
