{
  "name": "mapo-monorepo",
  "private": true,
  "description": "Monorepo for @mapomodule/* packages and mapomodule",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lotrekagency/mapo-new.git"
  },
  "scripts": {
    "build": "turbo run build",
    "build:release": "turbo run build --filter='./packages/**'",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "docs:dev": "pnpm --filter @mapomodule/docs dev",
    "docs:build": "turbo run docs:build",
    "dev:example": "pnpm --filter @mapomodule/example dev",
    "dev:example-theme": "pnpm --filter @mapomodule/example-theme dev",
    "dev:example-form": "pnpm --filter @mapomodule/example-custom-form dev",
    "dev:example-e2e": "pnpm --filter @mapomodule/example-e2e dev",
    "dev:core": "pnpm --filter @mapomodule/core dev",
    "dev:store": "pnpm --filter @mapomodule/store dev",
    "dev:uikit": "pnpm --filter @mapomodule/uikit dev",
    "dev:utils": "pnpm --filter @mapomodule/utils dev",
    "dev:mapomodule": "pnpm --filter mapomodule dev",
    "dev:camomilla": "pnpm --filter mapo-integrations-camomilla dev",
    "dev:form": "pnpm --filter @mapomodule/form dev",
    "dev:packages": "turbo run dev --filter='./packages/**'",
    "prepare": "husky",
    "release": "pnpm build:release && multi-semantic-release --ignore-private-packages",
    "release:dry": "pnpm build:release && multi-semantic-release --dry-run --ignore-private-packages",
    "publish:packages": "pnpm -r --filter './packages/**' publish --access public --no-git-checks"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.6",
  "lint-staged": {
    "**/*.{ts,tsx,vue,json,md}": [
      "pnpm exec prettier --write"
    ],
    "**/*.{ts,tsx,vue}": [
      "pnpm exec vitest related --run"
    ]
  },
  "multiSemanticRelease": {
    "deps": {
      "bump": "inherit",
      "release": "inherit"
    },
    "ignorePackages": [
      "@mapomodule/docs",
      "@mapomodule/example",
      "@mapomodule/example-theme",
      "@mapomodule/example-custom-form",
      "@mapomodule/example-e2e",
      "@mapomodule/i18n",
      "mapo-integrations-camomilla"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^10.2.1",
    "eslint-plugin-vue": "^10.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "multi-semantic-release": "^3.1.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.3.4"
  }
}
